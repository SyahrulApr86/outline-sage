# ============================================================
# outline-sage infra — environment variables
# Copy to .env and fill in the values
# ============================================================

# Existing Outline deployment (docker-compose-collection/outline)
OUTLINE_API_URL=http://outline:3000
OUTLINE_API_TOKEN=
OUTLINE_WEBHOOK_SECRET=

# Existing Keycloak realm shared with Outline
KEYCLOAK_ISSUER=http://keycloak:8080/realms/magnolia

# New OIDC client created in that realm for outline-sage
SAGE_KEYCLOAK_CLIENT_ID=outline-sage
SAGE_KEYCLOAK_CLIENT_SECRET=

# Generate with: openssl rand -hex 32
SAGE_AUTH_SECRET=

# Public URL where the Web App is reachable
SAGE_PUBLIC_URL=http://localhost:3001

# Postgres metadata sage (separate from Outline's Postgres)
SAGE_POSTGRES_USER=sage
SAGE_POSTGRES_PASSWORD=changeme
SAGE_POSTGRES_DB=sage
